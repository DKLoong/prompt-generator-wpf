<Window x:Class="PromptGenerator.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Width="560" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="HistoryWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- 搜索框样式：视觉同 FieldInput（暗底圆角、hover 提亮、聚焦紫框）。
             区别：PART_ContentHost 不额外叠加 Padding——FieldInput 将 Padding 同时绑给 ScrollViewer Margin，
             而 TextBoxView 内部又消费同一 Padding，文本实际左偏移 = 2×Padding，比占位文字明显靠后；
             本样式仅让 TextBoxView 内部单次应用 Padding（5px），与占位文字（Padding+边框=6px）同基准对齐 -->
        <Style x:Key="HistorySearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：标题 + 搜索框（与标题/关闭按钮外边距均 6px）+ 关闭按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="历史记录" Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="6,0,6,0">
                    <TextBox x:Name="SearchBox" Height="26"
                             Style="{StaticResource HistorySearchBox}" FontSize="12"
                             TextChanged="SearchBox_TextChanged" ToolTip="搜索历史记录"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>
                    <!-- 占位提示：光标未插入且文本为空时显示（聚焦/输入时隐藏，代码切换 Visibility），不参与命中测试/聚焦 -->
                    <TextBlock x:Name="SearchWatermark" Text="请输入关键词进行检索"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               IsHitTestVisible="False" Visibility="Visible"/>
                </Grid>
                <Button x:Name="CloseBtn" Grid.Column="2" Content="✕" Width="26" Height="26" HorizontalAlignment="Right"
                        Style="{StaticResource IconBtn}" Click="CloseBtn_Click"
                        GotKeyboardFocus="CloseBtn_GotKeyboardFocus" LostKeyboardFocus="CloseBtn_LostKeyboardFocus">
                    <Button.ToolTip>
                        <ToolTip Content="关闭"/>
                    </Button.ToolTip>
                </Button>
            </Grid>

            <!-- 历史列表 -->
            <!-- Tab 仅在有操作意义的按钮间循环（关闭/复制/编辑/删除）：
                 ScrollViewer/ItemsControl/只读提示文本均不作为 Tab 停靠点；提示文本仍可用鼠标选中 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <ItemsControl x:Name="HistoryList" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel2Brush}" CornerRadius="6"
                                    Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TemplateName}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=' · {0:MM-dd HH:mm}'}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="CopyBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="编辑" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="EditBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="删除" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="DeleteBtn_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding Prompt}"
                                             Foreground="{StaticResource TextBrush}" FontSize="12"
                                             TextWrapping="Wrap" IsReadOnly="True" IsTabStop="False"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0" Cursor="IBeam"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             SelectionOpacity="0.4"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
