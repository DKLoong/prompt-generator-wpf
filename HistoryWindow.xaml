<Window x:Class="PromptGenerator.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Width="560" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="历史记录" Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" Width="26" Height="26" HorizontalAlignment="Right"
                        Style="{StaticResource IconBtn}" Click="CloseBtn_Click" ToolTip="关闭"/>
            </Grid>

            <!-- 历史列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel2Brush}" CornerRadius="6"
                                    Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TemplateName}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=' · {0:MM-dd HH:mm}'}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="CopyBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="编辑" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="EditBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="删除" Width="48" Height="24" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="11"
                                                    Background="{StaticResource BorderBrush}"
                                                    Click="DeleteBtn_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding Prompt}"
                                             Foreground="{StaticResource TextBrush}" FontSize="12"
                                             TextWrapping="Wrap" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0" Cursor="IBeam"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             SelectionOpacity="0.4"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
