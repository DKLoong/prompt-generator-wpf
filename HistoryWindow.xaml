<Window x:Class="PromptGenerator.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PromptGenerator"
        Title="历史记录" Width="560" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="HistoryWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- 搜索框样式：视觉同 FieldInput（暗底圆角、hover 提亮、聚焦紫框）。
             区别：PART_ContentHost 不额外叠加 Padding——FieldInput 将 Padding 同时绑给 ScrollViewer Margin，
             而 TextBoxView 内部又消费同一 Padding，文本实际左偏移 = 2×Padding，比占位文字明显靠后；
             本样式仅让 TextBoxView 内部单次应用 Padding（5px），与占位文字（Padding+边框=6px）同基准对齐 -->
        <Style x:Key="HistorySearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0" />
                                <!-- 清空按钮：右侧独立区（与模板框箭头区同尺寸 26px），点击清空搜索框 -->
                                <Button x:Name="ClearBtn" Grid.Column="1" Focusable="False" ClickMode="Press"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="SearchClearBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- 分隔线：清空区左缘描边通长（上下抵搜索框边缘），聚焦搜索框时高亮紫色（与模板框箭头区一致） -->
                                <Border x:Name="sep" Grid.Column="1" BorderThickness="1,0,0,0"
                                        BorderBrush="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
                                <Path x:Name="ClearIcon" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                      Data="M 0,0 L 6,6 M 6,0 L 0,6" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="sep" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <!-- 文本为空：隐藏清空区（按钮/分隔线/图标） -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ClearBtn" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="sep" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ClearIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="ClearBtn" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="sep" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ClearIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：标题 + 搜索框（与标题/关闭按钮外边距均 6px）+ 关闭按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="历史记录" Foreground="{DynamicResource TextBrush}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="8,0,8,0">
                    <TextBox x:Name="SearchBox" Height="28"
                             Style="{StaticResource HistorySearchBox}" FontSize="14"
                             TextChanged="SearchBox_TextChanged" ToolTip="搜索历史记录"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>
                    <!-- 占位提示：光标未插入且文本为空时显示（聚焦/输入时隐藏，代码切换 Visibility），不参与命中测试/聚焦 -->
                    <TextBlock x:Name="SearchWatermark" Text="请输入关键词进行检索"
                               Foreground="{DynamicResource MutedBrush}" FontSize="14"
                               VerticalAlignment="Center" Margin="9,0,0,0"
                               IsHitTestVisible="False" Visibility="Visible"/>
                </Grid>
                <Button x:Name="CloseBtn" Grid.Column="2" Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource IconBtn}" Click="CloseBtn_Click"
                        GotKeyboardFocus="CloseBtn_GotKeyboardFocus" LostKeyboardFocus="CloseBtn_LostKeyboardFocus">
                    <Button.ToolTip>
                        <ToolTip Content="关闭"/>
                    </Button.ToolTip>
                </Button>
            </Grid>

            <!-- 历史列表 -->
            <!-- Tab 仅在有操作意义的按钮间循环（关闭/复制/编辑/删除）：
                 ScrollViewer/ItemsControl/只读提示文本均不作为 Tab 停靠点；提示文本仍可用鼠标选中 -->
            <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <ItemsControl x:Name="HistoryList" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Panel2Brush}" CornerRadius="8"
                                    Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TemplateName}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=' · {0:MM-dd HH:mm}'}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="14"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Width="48" Height="28" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="12"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Click="CopyBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="编辑" Width="48" Height="28" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="12"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Click="EditBtn_Click" Tag="{Binding Id}"/>
                                            <Button Content="删除" Width="48" Height="28" Margin="4,0,0,0"
                                                    Style="{StaticResource ActionBtn}" FontSize="12"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Click="DeleteBtn_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding Prompt}"
                                             Foreground="{DynamicResource TextBrush}" FontSize="14"
                                             TextWrapping="Wrap" IsReadOnly="True" IsTabStop="False"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0" Cursor="IBeam"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionOpacity="0.4"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 轻提示（toast）：悬浮于列表区顶部、水平居中，随窗口移动；独立于布局（Collapsed 不占空间）。
                 默认不挡点击（IsHitTestVisible=False）；带"撤销"按钮时置 True 以允许点击撤销 -->
            <Border x:Name="ToastLayer" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,4,0,8" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,4" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Toast" FontSize="14" Foreground="{DynamicResource OkBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="UndoBtn" Content="撤销" Margin="8,0,0,0" Padding="8,4"
                            FontSize="12" Visibility="Collapsed" Click="UndoBtn_Click"
                            ToolTip="撤销刚才的操作" ToolTipService.InitialShowDelay="800">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 圆角矩形淡紫高亮：与全局 ActionBtn 高亮体系一致 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 确认弹层（popconfirm）：锚定触发按钮，Custom 放置由 WPF 在多候选中自动选完整落屏位置，
                 解决窗口贴屏幕边缘时显示不全；非模态（点外部自动关闭=取消） -->
            <Popup x:Name="ConfirmPopup" Placement="Custom" AllowsTransparency="True"
                   Focusable="True" StaysOpen="False" PopupAnimation="Fade"
                   CustomPopupPlacementCallback="{x:Static local:App.ConfirmPopupPlacement}"
                   Opened="ConfirmPopup_Opened">
                <!-- 内容 Border 直接子元素（对齐规则与回调一致）；底部 Margin 16 为垂直软阴影预留外扩空间。
                     MaxWidth 260：窄弹层使对齐候选能通过 WPF 落屏（弹窗+按钮在窗口右部时右缘不越界） -->
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12"
                        MinWidth="220" MaxWidth="260" Margin="0,0,0,16"
                        PreviewKeyDown="ConfirmPopup_PreviewKeyDown">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.3" />
                    </Border.Effect>
                        <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="ConfirmMsg" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ConfirmCancel" Content="取消" Width="64" Height="28"
                                    Margin="0,0,8,0" Style="{StaticResource ActionBtn}"
                                    Click="ConfirmCancel_Click" />
                            <Button x:Name="ConfirmOk" Content="确定" Width="64" Height="28"
                                    Style="{StaticResource ConfirmBtn}" Click="ConfirmOk_Click"
                                    GotKeyboardFocus="ConfirmOk_GotKeyboardFocus"
                                    LostKeyboardFocus="ConfirmOk_LostKeyboardFocus" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
