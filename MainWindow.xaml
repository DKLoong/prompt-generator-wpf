<Window x:Class="PromptGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PromptGenerator.Controls"
        xmlns:local="clr-namespace:PromptGenerator"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示词生成器"
        Icon="Assets/app-icon.png"
        Width="400" Height="800" MinWidth="400" MinHeight="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="Manual" Topmost="True"
        ShowInTaskbar="True" Closing="Window_Closing"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <!-- popconfirm 确认按钮：模板同 ActionBtn，仅高亮（hover/键盘聚焦/按下）用柔和红；取消按钮直接用全局 ActionBtn（高亮淡紫）。
             ConfirmBrush/ConfirmHoverBrush 已在主题字典中定义（随主题切换，保留红语义） -->
        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停显示柔和红（鼠标路径：仅 hover 高亮）；键盘聚焦红由代码控制
                                 （ConfirmOk_GotKeyboardFocus：程序化/键盘聚焦显示，鼠标点击聚焦不显示） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ConfirmBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ConfirmHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框窗口：6px 隐藏缩放边框，CaptionHeight=0（拖动用自绘 DragMove） -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border CornerRadius="8" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="PinBtn" Width="24" Height="24"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="切换窗口置顶"
                            ToolTipService.InitialShowDelay="800"
                            ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                            Click="PinBtn_Click">
                        <!-- 默认前景用 Style setter 而非本地值：本地值优先级高于模板触发器（置顶态紫图标无法生效），
                             且失焦 ClearValue 会连本地值一起清掉回退默认黑。Style setter 优先级低于模板触发器，
                             置顶态紫图标生效；ClearValue 后回落样式浅灰（非置顶）/触发器紫（置顶）。 -->
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="20" Height="20" CornerRadius="4"
                                        Background="Transparent" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- 未置顶：hover 浅灰底（与标题栏其他按钮一致） -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel2Brush}" />
                                    </Trigger>
                                    <!-- 键盘聚焦视觉由代码控制（OnButtonGotKeyboardFocus）：仅键盘导航聚焦时亮淡紫底，
                                         鼠标点击聚焦不亮（避免点击置顶切换时闪烁紫填充） -->
                                    <!-- 置顶态：仅强调色图标，无描边（重绘后图标饱满，描边显拥挤，故去掉边框）；放最后，
                                         hover/press 时不叠填充（点击切换置顶不闪填充） -->
                                    <Trigger Property="Tag" Value="pinned">
                                        <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Stretch="Uniform" Width="16" Height="16">
                            <!-- 置顶图标：线性图钉（顶横线 + 尖朝上箭头 + 竖针），1.5px 圆角线性，Stroke 跟随 Foreground（置顶态亮紫） -->
                            <Path Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 2.5,1.6 L 13.3,1.6 M 8,3.4 L 2.5,8.8 M 8,3.4 L 13.5,8.8 M 8,5.8 L 8,14.5" />
                        </Viewbox>
                    </Button>
                    <TextBlock Text="提示词生成器" Foreground="{DynamicResource MutedBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="HistoryBtn" Style="{StaticResource TitleBtn}" ToolTip="历史记录"
                            Click="HistoryBtn_Click">
                        <Viewbox Stretch="Uniform" Width="16" Height="16">
                            <!-- 历史记录图标：线性时钟（4 条等距横线 + 时钟圆 + 时针/分针），1.5px 圆角线性，Stroke 跟随 Foreground -->
                            <Path Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 0.8,1.2 L 12.8,1.2 M 0.8,5.25 L 5.8,5.25 M 0.8,9.3 L 4.2,9.3 M 0.8,13.35 L 5,13.35 M 10.3,5.1 A 4.7,4.7 0 1 1 10.3,14.5 A 4.7,4.7 0 1 1 10.3,5.1 M 10.3,9.8 L 10.3,7.0 M 10.3,9.8 L 13.0,9.8" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource TitleBtn}"
                            ToolTip="设置" Click="SettingsBtn_Click">
                        <Viewbox Stretch="Uniform" Width="16" Height="16">
                            <!-- 设置图标：线性正六边形 + 中心圆环（参考图实形），1.5px 圆角线性，Stroke 跟随 Foreground -->
                            <Path Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 4,2.2 L 12,2.2 L 14.8,8 L 12,13.8 L 4,13.8 L 1.2,8 Z M 8,5.72 A 2.24,2.24 0 1 1 8,10.2 A 2.24,2.24 0 1 1 8,5.72" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#x2013;"
                            ToolTip="最小化" Click="MinBtn_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#x2715;"
                            ToolTip="隐藏到托盘" Click="CloseBtn_Click" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>

            <!-- 模板工具栏 -->
            <Grid x:Name="TemplateBar" Grid.Row="1" Margin="12,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TemplateBox" Height="28" Margin="0,0,8,0"
                          FontWeight="SemiBold"
                          Style="{StaticResource RoundComboBox}"
                          IsEditable="True" IsTextSearchEnabled="False"
                          IsSynchronizedWithCurrentItem="False"
                          TextBoxBase.TextChanged="TemplateBox_TextChanged"
                          SelectionChanged="TemplateBox_SelectionChanged"
                          PreviewTextInput="TemplateBox_PreviewTextInput"
                          PreviewMouseLeftButtonDown="TemplateBox_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="TemplateBox_PreviewMouseLeftButtonUp"
                          MouseLeftButtonUp="TemplateBox_MouseLeftButtonUp"
                          DropDownOpened="TemplateBox_DropDownOpened"
                          GotKeyboardFocus="TemplateBox_GotKeyboardFocus"
                          LostKeyboardFocus="TemplateBox_LostKeyboardFocus"
                          VerticalContentAlignment="Center" />
                <!-- 模板操作：重命名 / 新增 / 保存 / 重置 / 删除（图标按钮，ToolTip 提示语义，保存含 Ctrl+S 快捷键） -->
                <Button x:Name="RenameBtn" Grid.Column="1" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="重命名模板" Click="RenameTemplate_Click">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <!-- 重命名图标：左⊏文档框 + 中央贯穿竖线（上下圆头）+ 右⊐框，1.5px 圆角线性，Stroke 跟随 Foreground -->
                        <Path Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 7.5,5.4 L 2,5.4 L 2,11.4 L 7.5,11.4 M 3,8.5 L 6.5,8.5 M 10,3 L 10,14 M 7.6,2.5 L 12.4,2.5 M 7.6,14.5 L 12.4,14.5 M 12.5,5.4 L 14.5,5.4 L 14.5,11.4 L 12.5,11.4" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="新增模板" Click="NewTemplate_Click">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <!-- 新增图标：列表轮廓（顶边+左壁+底边+右上小短线）+ 两条文本线 + 右侧加号，1.5px 圆角线性，Stroke 跟随 Foreground -->
                        <Path Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 13.8,2.3 L 2.7,2.3 L 2.7,12.6 L 8,12.6 M 13.8,2.3 L 13.8,4.3 M 4.5,4.8 L 9.8,4.8 M 4.5,7 L 7.3,7 M 10.8,6.8 L 10.8,12.8 M 7.8,9.8 L 13.8,9.8" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="保存到模板 (Ctrl+S)" Click="SaveTemplate_Click">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <!-- 保存图标：线性软盘（外框闭合折线 + 顶部 U 形槽连续折线 + 中部标签横条），1.5px 圆角线性，Stroke 跟随 Foreground -->
                        <Path Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 13.1,2.4 L 2.7,2.4 L 2.7,13.6 L 13.1,13.6 L 13.1,2.4 Z M 5.7,2.8 L 5.7,6.4 L 10.3,6.4 L 10.3,2.8 M 5.7,9.6 L 10.3,9.6" />
                    </Viewbox>
                </Button>
                <Button x:Name="ResetBtn" Grid.Column="4" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="重置模板" Click="ResetTemplate_Click">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <!-- 重置图标：连续 < 箭头尖 + 半圆右弧（与上下横条相切）+ 3 条列表线，1.5px 圆角线性，Stroke 跟随 Foreground -->
                        <Path Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 4,1.1 L 1.5,4.1 L 4.1,7.1 M 1.4,4.1 L 10,4.1 M 10,4.1 A 5.2,5.2 0 0 1 15.2,9.3 A 5.2,5.2 0 0 1 10,14.5 M 1.9,14.5 L 10,14.5 M 6.5,7.4 L 12.4,7.4 M 6.5,9.4 L 12.4,9.4 M 6.5,11.4 L 9.9,11.4" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconActionBtn}"
                        ToolTip="删除模板" Click="DeleteTemplate_Click">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <!-- 删除图标：线性垃圾桶（提手 + 盖 + 桶身 U 形连续折线 + 2 条竖条纹），1.5px 圆角线性，Stroke 跟随 Foreground -->
                        <Path Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 5,1.5 L 11,1.5 M 1,3.5 L 15,3.5 M 3.4,5.5 L 3.4,14.5 L 12.5,14.5 L 12.5,5.5 M 6.4,6.5 L 6.4,12.9 M 9.5,6.5 L 9.5,12.9" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- 字段区 -->
            <!-- Hidden：滚动条不可见但始终预留其布局位置，避免内容刚好超出视口时弹出滚动条挤压内容宽度。
                 Padding 右边取 0，由滚动条预留的 ~10px 充当右边距，与左边距视觉对称。 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Padding="12,0,0,4">
                <!-- 底部 Margin 12px：最后一个 RowGap 负下边距的渲染溢出 4px 超出 StackPanel 边界、不计入滚动范围，
                     滚动到底时会被视口裁剪，底部留白保证其完整可见 -->
                <StackPanel x:Name="FieldHost" Margin="0,0,0,12" />
            </ScrollViewer>

            <!-- 底部操作 -->
            <Grid Grid.Row="3" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctrl:SplitButton x:Name="ActionButton" VerticalAlignment="Center" />
            </Grid>

            <!-- 轻提示：窗口内覆盖层，悬浮于模板工具栏下方（Grid.Row=2 顶部），随窗口移动、
                 水平居中；独立于布局（Collapsed 时不占空间），消除按钮伸缩抖动。
                 默认不挡点击（IsHitTestVisible=False）；带"撤销"按钮时置 True 以允许点击撤销 -->
            <Border x:Name="ToastLayer" Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,4,0,8" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,4" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Toast" FontSize="14" Foreground="{DynamicResource OkBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="UndoBtn" Content="撤销" Margin="8,0,0,0" Padding="8,4"
                            FontSize="12" Visibility="Collapsed" Click="UndoBtn_Click"
                            ToolTip="撤销刚才的操作" ToolTipService.InitialShowDelay="800">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 圆角矩形淡紫高亮：与全局 ActionBtn 高亮体系一致 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 确认弹层（popconfirm）：锚定触发按钮，Custom 放置由 WPF 在多候选中自动选完整落屏位置，
                 解决窗口贴屏幕边缘时显示不全；非模态（点外部自动关闭=取消） -->
            <Popup x:Name="ConfirmPopup" Placement="Custom" AllowsTransparency="True"
                   Focusable="True" StaysOpen="False" PopupAnimation="Fade"
                   CustomPopupPlacementCallback="{x:Static local:App.ConfirmPopupPlacement}"
                   Opened="ConfirmPopup_Opened">
                <!-- 外层 Margin 预留垂直软阴影空间（10,8,10,14），ConfirmPlacement 回调已同步补偿内容对齐 -->
                <Border Margin="10,8,10,14" Background="Transparent">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            MinWidth="220" MaxWidth="320"
                            PreviewKeyDown="ConfirmPopup_PreviewKeyDown">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.3" />
                        </Border.Effect>
                        <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="ConfirmMsg" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ConfirmCancel" Content="取消" Width="64" Height="28"
                                    Margin="0,0,8,0" Style="{StaticResource ActionBtn}"
                                    Click="ConfirmCancel_Click" />
                            <Button x:Name="ConfirmOk" Content="确定" Width="64" Height="28"
                                    Style="{StaticResource ConfirmBtn}" Click="ConfirmOk_Click"
                                    GotKeyboardFocus="ConfirmOk_GotKeyboardFocus"
                                    LostKeyboardFocus="ConfirmOk_LostKeyboardFocus" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Border>
            </Popup>

            <!-- 托盘图标（不可见元素，不参与布局；IconSource 在代码中从 Assets/app-icon.png 加载） -->
            <tb:TaskbarIcon x:Name="TrayIcon" Grid.Row="0"
                            ToolTipText="提示词生成器（左键显示/隐藏，右键菜单）"
                            TrayLeftMouseUp="TrayToggle_Click">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="显示/隐藏" Click="TrayToggle_Click" />
                        <MenuItem Header="设置" Click="SettingsBtn_Click" />
                        <Separator />
                        <MenuItem Header="退出" Click="TrayExit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Border>
</Window>
