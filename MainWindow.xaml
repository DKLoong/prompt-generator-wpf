<Window x:Class="PromptGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PromptGenerator.Controls"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示词生成器"
        Icon="Assets/app-icon.png"
        Width="365" Height="600" MinWidth="365" MinHeight="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="Manual" Topmost="True"
        ShowInTaskbar="True" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框窗口：6px 隐藏缩放边框，CaptionHeight=0（拖动用自绘 DragMove） -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border CornerRadius="10" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="PinBtn" Width="24" Height="24"
                            FontSize="13" Content="&#x1F4CC;" FontFamily="Segoe UI Emoji"
                            Foreground="#9a9bb5"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="切换窗口置顶"
                            ToolTipService.InitialShowDelay="800"
                            ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                            Click="PinBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="22" Height="22" CornerRadius="5"
                                        Background="Transparent" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- 未置顶：hover 浅灰底 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3c3d57" />
                                    </Trigger>
                                    <!-- 置顶态：紫色描边 + 紫色图标；放最后，hover/press 时不叠紫填充 -->
                                    <Trigger Property="Tag" Value="pinned">
                                        <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#7c6cf0" />
                                        <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                                        <Setter Property="Foreground" Value="#7c6cf0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="提示词生成器" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="HistoryBtn" Style="{StaticResource TitleBtn}" ToolTip="历史记录"
                            Click="HistoryBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="22" Height="22" CornerRadius="4" Background="Transparent">
                                    <Viewbox Stretch="Uniform" Width="14" Height="14">
                                        <!-- 历史记录图标：环形逆时针箭头 + 时钟指针（填充式，颜色复用主题 MutedBrush） -->
                                        <!-- F1 = Nonzero 填充规则（与 SVG 默认一致），避免图标内部出现镂空 -->
                                        <Path Fill="{StaticResource MutedBrush}"
                                              Data="F1 M144.050432 311.120128C150.72016 298.14528 159.483744 281.657568 165.972256 271.480736 245.506592 146.735712 385.091328 64 544 64 791.423552 64 992 264.576448 992 512 992 759.423552 791.423552 960 544 960 383.12528 960 242.055648 875.204416 163.047904 747.870016 152.260384 730.484064 148.608608 721.877024 148.608608 721.877024 140.526912 706.07824 121.00352 698.887232 104.646144 705.605952 88.174688 712.371488 81.331744 730.490304 89.107264 746.180064 89.107264 746.180064 94.27984 757.936064 105.745536 776.866816 195.465184 925.000928 358.17136 1024 544 1024 826.769792 1024 1056 794.769792 1056 512 1056 229.230208 826.769792 0 544 0 360.797344 0 200.068256 96.220896 109.592672 240.882816 105.015264 248.201632 99.386304 258.44688 94.010208 268.65776L76.719904 159.49104C73.980704 142.19648 57.73136 130.398432 40.154144 133.182368 22.698592 135.947072 10.815968 152.506944 13.539136 169.700448L38.593024 327.884448C44.117152 362.762368 76.620576 386.597728 111.74736 381.034208L269.931392 355.98032C287.335072 353.22384 299.2216 336.96048 296.437632 319.383232 293.67296 301.927712 277.178208 290.034752 260.117184 292.73696L144.050432 311.120128 144.050432 311.120128 144.050432 311.120128ZM544 223.852736C544 206.26096 529.79632 192 512 192 494.32688 192 480 206.584352 480 224.079136L480 511.72704C480 547.224 508.8624 576 544.27296 576L831.920864 576C849.637664 576 864 561.79632 864 544 864 526.32688 849.418752 512 832.147264 512L575.852736 512C558.26096 512 544 497.418752 544 480.147264L544 223.852736 544 223.852736 544 223.852736Z"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3c3d57" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource TitleBtn}" Content="⚙"
                            ToolTip="设置" Click="SettingsBtn_Click" />
                    <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#x2013;"
                            ToolTip="最小化" Click="MinBtn_Click" />
                    <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#x2715;"
                            ToolTip="隐藏到托盘" Click="CloseBtn_Click" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>

            <!-- 模板工具栏 -->
            <Grid x:Name="TemplateBar" Grid.Row="1" Margin="10,2,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TemplateBox" Height="28" Margin="0,0,8,0"
                          Style="{StaticResource RoundComboBox}"
                          IsEditable="True" IsTextSearchEnabled="False"
                          IsSynchronizedWithCurrentItem="False"
                          TextBoxBase.TextChanged="TemplateBox_TextChanged"
                          SelectionChanged="TemplateBox_SelectionChanged"
                          PreviewTextInput="TemplateBox_PreviewTextInput"
                          PreviewMouseLeftButtonDown="TemplateBox_PreviewMouseLeftButtonDown"
                          LostKeyboardFocus="TemplateBox_LostKeyboardFocus"
                          VerticalContentAlignment="Center" />
                <!-- 模板操作：重命名 / 新增 / 保存 / 删除（图标按钮，ToolTip 提示语义，保存含 Ctrl+S 快捷键） -->
                <Button Grid.Column="1" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="重命名模板" Click="RenameTemplate_Click">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M800 64a32 32 0 1 1 0 64h-64v832h64a32 32 0 1 1 0 64h-192a32 32 0 1 1 0-64h64V128h-64a32 32 0 0 1 0-64h192z M576 224v0.256a32 32 0 1 1 0 64H480L477.12 288H192a128 128 0 0 0-127.68 118.4L64 416v192a128 128 0 0 0 118.4 127.68L192 736h384a32 32 0 1 1 0 64H192A192 192 0 0 1 0.32 619.264L0 608v-192a192 192 0 0 1 180.736-191.68L192 224h384z m256 0a192 192 0 0 1 191.68 180.736L1024 416v192a192 192 0 0 1-180.736 191.68L832 800a32 32 0 0 1-5.888-63.488l5.76-0.512a128 128 0 0 0 127.808-118.4L960 608v-192a128 128 0 0 0-118.4-127.68L832 288a32 32 0 1 1-6.272-63.488L832 224z M240 464a48 48 0 1 1 0 96 48 48 0 0 1 0-96z m304 16a32 32 0 0 1 0 64h-192a32 32 0 0 1 0-64h192z" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="新增模板" Click="NewTemplate_Click">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M618 958.5H202c-44.8 0-81.3-34.1-81.3-76v-740c0-41.9 36.5-76 81.3-76h610.5c44.8 0 81.3 34.1 81.3 76v521.9c0 12.8-10.4 23.1-23.1 23.1s-23.1-10.4-23.1-23.1V142.5c0-16.4-15.7-29.7-35-29.7H202c-19.3 0-35 13.3-35 29.7v740c0 16.4 15.7 29.7 35 29.7h416c12.8 0 23.1 10.4 23.1 23.1 0.1 12.8-10.3 23.2-23.1 23.2z M738.4 360.5H276c-12.8 0-23.1-10.4-23.1-23.1 0-12.8 10.4-23.1 23.1-23.1h462.5c12.8 0 23.1 10.4 23.1 23.1 0 12.8-10.4 23.1-23.2 23.1z M584.3 595.1H276c-12.8 0-23.1-10.4-23.1-23.1 0-12.8 10.4-23.1 23.1-23.1h308.3c12.8 0 23.1 10.4 23.1 23.1 0 12.7-10.3 23.1-23.1 23.1z M878.8 826.3H614.6c-12.8 0-23.1-10.4-23.1-23.1 0-12.8 10.4-23.1 23.1-23.1h264.3c12.8 0 23.1 10.4 23.1 23.1 0 12.8-10.4 23.1-23.2 23.1z M746.7 958.5c-12.8 0-23.1-10.4-23.1-23.1V671.1c0-12.8 10.4-23.1 23.1-23.1 12.8 0 23.1 10.4 23.1 23.1v264.3c0 12.7-10.3 23.1-23.1 23.1z" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconActionBtn}" Margin="0,0,4,0"
                        ToolTip="保存到模板 (Ctrl+S)" Click="SaveTemplate_Click">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M725.4 105.7H151.8c-27.1 0-49.2 22-49.2 49.1v711.8c0 27.1 22.1 49.1 49.2 49.1H866c27.1 0 49.2-22 49.2-49.1V294.8L725.4 105.7z m-399.4 40h338.8v241.9c0 12.9-10.5 23.3-23.5 23.3H349.5c-12.9 0-23.5-10.5-23.5-23.3V145.7z m5.4 727.6V612.5c0-4.1 3.4-7.4 7.5-7.4h363.4c4.1 0 7.5 3.3 7.5 7.4v260.8H331.4z m543.8-6.8c0 4.9-4.2 9.1-9.2 9.1H749.9V612.5c0-26.1-21.3-47.4-47.5-47.4H339c-26.2 0-47.5 21.3-47.5 47.4v263.2H151.8c-5 0-9.2-4.2-9.2-9.1V154.8c0-4.9 4.2-9.1 9.2-9.1H286v241.9c0 34.9 28.5 63.3 63.5 63.3h291.8c35 0 63.5-28.4 63.5-63.3V145.7h4l166.4 165.8v555z M638.4 664H400.8c-11 0-20 9-20 20s9 20 20 20h237.6c11 0 20-9 20-20s-8.9-20-20-20z M638.4 765.1H400.8c-11 0-20 9-20 20s9 20 20 20h237.6c11 0 20-9 20-20s-8.9-20-20-20z" />
                    </Viewbox>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconActionBtn}"
                        ToolTip="删除模板" Click="DeleteTemplate_Click">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M967.111111 173.511111H56.888889c-8.533333 0-14.222222-2.844444-19.911111-5.688889-5.688889-5.688889-8.533333-14.222222-8.533334-22.755555s2.844444-14.222222 8.533334-19.911111c5.688889-5.688889 11.377778-8.533333 19.911111-8.533334h910.222222c8.533333 0 14.222222 2.844444 19.911111 8.533334 5.688889 5.688889 8.533333 11.377778 8.533334 19.911111 0 8.533333-2.844444 14.222222-8.533334 19.911111-5.688889 5.688889-11.377778 8.533333-19.911111 8.533333z M674.133333 56.888889H349.866667c-8.533333 0-14.222222 0-19.911111-5.688889s-8.533333-11.377778-8.533334-19.911111 2.844444-14.222222 8.533334-19.911111c5.688889-8.533333 11.377778-11.377778 19.911111-11.377778h321.422222c8.533333 0 14.222222 2.844444 19.911111 8.533333s8.533333 11.377778 8.533333 19.911111-2.844444 14.222222-8.533333 19.911112-8.533333 8.533333-8.533333 8.533333z M381.155556 819.2V321.422222c0-8.533333 2.844444-14.222222 8.533333-19.911111s11.377778-8.533333 19.911111-8.533333 14.222222 2.844444 19.911111 8.533333c5.688889 5.688889 8.533333 11.377778 8.533333 19.911111v497.777778c0 8.533333-2.844444 14.222222-8.533333 19.911111-5.688889 5.688889-11.377778 8.533333-19.911111 8.533333s-14.222222-2.844444-19.911111-8.533333c-5.688889-5.688889-8.533333-11.377778-8.533333-19.911111z M153.6 273.066667c5.688889-5.688889 11.377778-8.533333 19.911111-8.533334 8.533333 0 14.222222 2.844444 19.911111 8.533334s8.533333 11.377778 8.533334 19.911111v614.4c0 17.066667 5.688889 31.288889 17.066666 42.666666 14.222222 11.377778 28.444444 17.066667 45.511111 17.066667h497.777778c17.066667 0 31.288889-5.688889 42.666667-17.066667 11.377778-11.377778 17.066667-25.6 17.066666-42.666666V292.977778c0-8.533333 2.844444-14.222222 8.533334-19.911111 5.688889-5.688889 14.222222-8.533333 19.911111-8.533334 8.533333 0 14.222222 2.844444 19.911111 8.533334s8.533333 11.377778 8.533333 19.911111v642.844444c0 25.6-8.533333 45.511111-25.6 62.577778-17.066667 17.066667-36.977778 25.6-62.577777 25.6H233.244444c-25.6 0-45.511111-8.533333-62.577777-25.6-17.066667-17.066667-25.6-36.977778-25.6-62.577778V292.977778c0-8.533333 2.844444-14.222222 8.533333-19.911111z" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- 字段区 -->
            <!-- Hidden：滚动条不可见但始终预留其布局位置，避免内容刚好超出视口时弹出滚动条挤压内容宽度。
                 Padding 右边取 0，由滚动条预留的 ~10px 充当右边距，与左边距视觉对称。 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Padding="10,0,0,4">
                <StackPanel x:Name="FieldHost" />
            </ScrollViewer>

            <!-- 底部操作 -->
            <Grid Grid.Row="3" Margin="10,4,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctrl:SplitButton x:Name="ActionButton" VerticalAlignment="Center" />
            </Grid>

            <!-- 轻提示：窗口内覆盖层，悬浮于模板工具栏下方（Grid.Row=2 顶部），随窗口移动、
                 水平居中；独立于布局（Collapsed 时不占空间），消除按钮伸缩抖动 -->
            <Border x:Name="ToastLayer" Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,2,0,0" Background="#2B2B30"
                    BorderBrush="#7C6CF0" BorderThickness="1" CornerRadius="4"
                    Padding="10,3" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="Toast" FontSize="12" Foreground="{StaticResource OkBrush}" />
            </Border>

            <!-- 托盘图标（不可见元素，不参与布局；IconSource 在代码中从 Assets/app-icon.png 加载） -->
            <tb:TaskbarIcon x:Name="TrayIcon" Grid.Row="0"
                            ToolTipText="提示词生成器（左键显示/隐藏，右键菜单）"
                            TrayLeftMouseUp="TrayToggle_Click">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="显示/隐藏" Click="TrayToggle_Click" />
                        <MenuItem Header="设置" Click="SettingsBtn_Click" />
                        <Separator />
                        <MenuItem Header="退出" Click="TrayExit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Border>
</Window>
